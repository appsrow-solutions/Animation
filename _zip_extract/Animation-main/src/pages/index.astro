---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="is-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Agency work in motion" />
    <title>Works in Motion</title>
      <!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="https://cdn.prod.website-files.com/6a213c5f7179de515d9f790a/6a5a01205f9632d6c9bf4a82_appsrow-favicon.png"
  />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="loader" id="loader" aria-live="polite" aria-busy="true">
      <p class="loader__label">Works in Motion</p>
      <div class="loader__track">
        <div class="loader__bar" id="loader-bar"></div>
      </div>
      <p class="loader__pct" id="loader-pct">0%</p>
    </div>

    <a
      class="site-logo"
      href="https://www.appsrow.com/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Appsrow"
    >
      <img src="/assets/logo.png" alt="Appsrow" width="120" height="120" />
    </a>

    <a
      class="site-cta"
      href="https://tidycal.com/appsrowsolutions/30-minute-meeting"
      target="_blank"
      rel="noopener noreferrer"
    >
      Book a Call
    </a>

    <header class="section-heading">
      <h1 class="section-heading__title">Works in Motion</h1>
    </header>

    <a
      class="site-credit"
      href="https://www.appsrow.com/"
      target="_blank"
      rel="noopener noreferrer"
    >
      Powered by <span>Appsrow</span>
    </a>

    <div id="container"></div>
    <div id="scroll-spacer"></div>
    <script>
      import Sketch from "../scripts/app.js";

      const container = document.getElementById("container");
      const scrollSpacer = document.getElementById("scroll-spacer");
      const loader = document.getElementById("loader");
      const loaderBar = document.getElementById("loader-bar");
      const loaderPct = document.getElementById("loader-pct");

      if (container && scrollSpacer) {
        new Sketch({
          dom: container,
          scrollSpacer,
          loader,
          loaderBar,
          loaderPct,
        });
      }
    </script>
  </body>
</html>
